{
  "Name": "IwmmCatalogIndexAuthAware",
  "Comment": "GET /api/v1/sets varies by user. Auth is part of the cache key, so anonymous callers share one entry and signed in responses, which the origin marks private no-store, are never stored.",
  "MinTTL": 0,
  "DefaultTTL": 60,
  "MaxTTL": 3600,
  "ParametersInCacheKeyAndForwardedToOrigin": {
    "EnableAcceptEncodingGzip": true,
    "EnableAcceptEncodingBrotli": true,
    "HeadersConfig": {
      "HeaderBehavior": "whitelist",
      "Headers": { "Quantity": 2, "Items": ["Authorization", "X-API-Key"] }
    },
    "CookiesConfig": {
      "CookieBehavior": "whitelist",
      "Cookies": { "Quantity": 1, "Items": ["authorization"] }
    },
    "QueryStringsConfig": { "QueryStringBehavior": "all" }
  }
}
