{{~!--
  One format's grid of published decks (newest first).

  Context: a PublishedDeckRowView { format, label, decks, nextOffset, hasMore }.
  publishedDecks.js reads the data-* attributes to append the next batch when
  "Load more" is pressed, and mirrors this markup for AJAX-loaded sections.
--~}}
<section class="deck-section" data-format="{{format}}" data-next-offset="{{nextOffset}}" data-has-more="{{hasMore}}">
    <h2 class="font-display font-semibold text-lg text-gray-900 dark:text-white mb-3">{{label}}</h2>
    <div class="deck-section-grid grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {{#each decks}}
            {{>publishedDeckCard}}
        {{/each}}
    </div>
    {{#if hasMore}}
        <div class="deck-section-footer mt-4 flex justify-center">
            <button type="button" class="deck-section-more btn btn-secondary text-sm">
                Load more {{label}} decks
            </button>
        </div>
    {{/if}}
</section>
