{
  "Name": "IwmmPublicCatalogIdentity",
  "Comment": "Public catalog paths. Forwards caller credentials on a miss for rate limits; not in the cache key.",
  "HeadersConfig": {
    "HeaderBehavior": "whitelist",
    "Headers": {
      "Quantity": 4,
      "Items": ["Authorization", "X-API-Key", "X-RapidAPI-Proxy-Secret", "X-RapidAPI-User"]
    }
  },
  "CookiesConfig": {
    "CookieBehavior": "whitelist",
    "Cookies": { "Quantity": 1, "Items": ["authorization"] }
  },
  "QueryStringsConfig": { "QueryStringBehavior": "none" }
}
